name: mibici-equipo52

python_env: python_env.yaml

entry_points:
  ingest:
    command: "python -m equipo52_module.dataset"

  train:
    parameters:
      pregunta:
        type: string
        default: p1
      modelo:
        type: string
        default: ""
      periodo:
        type: string
        default: "completo"
      balanceado:
        type: string
        default: "false"
      k:
        type: int
        default: 0
      min_cluster_size:
        type: int
        default: 15
      solo_consolidadas:
        type: string
        default: "false"
      sin_redondos_cortos:
        type: string
        default: "false"
      max_iter:
        type: int
        default: 200
      learning_rate:
        type: float
        default: 0.1
      max_leaf_nodes:
        type: int
        default: 31
      peso_fallas:
        type: float
        default: 1.0

    command: "
    python -m equipo52_module.project_train
    --pregunta {pregunta}
    --modelo {modelo}
    --periodo {periodo}
    --balanceado {balanceado}
    --k {k}
    --min-cluster-size {min_cluster_size}
    --solo-consolidadas {solo_consolidadas}
    --sin-redondos-cortos {sin_redondos_cortos}
    --max-iter {max_iter}
    --learning-rate {learning_rate}
    --max-leaf-nodes {max_leaf_nodes}
    --peso-fallas {peso_fallas}"