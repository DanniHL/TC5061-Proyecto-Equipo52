# Copia este archivo como .env (cp .env.example .env) y ajusta los valores para tu computadora.
# .env está en .gitignore: nunca se sube a GitHub. Este archivo solo trae nombres y valores de ejemplo.

# Servidor de MLflow (config.py lo lee con python-dotenv; si falta, usa http://127.0.0.1:5000)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Si algún día se usa un servidor remoto con usuario, va aquí y no en el código:
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=